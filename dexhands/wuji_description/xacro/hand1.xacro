        <geometry>
          <mesh filename="file://$(find wuji_description)/meshes/hand1/${mesh_side}/${mesh_side}_finger1_tip_link.STL"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}finger1_tip_fixed" type="fixed">
      <origin xyz="-0.00105 0.0002 0.0313" rpy="0 0 0"/>
      <parent link="${prefix}finger1_link4"/>
      <child link="${prefix}finger1_tip_link"/>
    </joint>
    <link name="${prefix}finger2_link1">
      <inertial>
        <origin xyz="-0.0013291 ${direction*-5.6587e-09} 0.00031994" rpy="0 0 0"/>
        <mass value="0.0032"/>
        <inertia ixx="8e-08" ixy="0" ixz="-3e-08" iyy="7e-08" iyz="0" izz="8e-08"/>
