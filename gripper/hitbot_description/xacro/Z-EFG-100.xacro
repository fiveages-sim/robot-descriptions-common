<robot xmlns:xacro="http://ros.org/wiki/xacro" name="hitbot_gripper">

  <xacro:macro name="Gripper"
    params="name collider_type:=simple">
    <xacro:property name="prefix" value="${name + '_' if name else 'gripper_'}"/>
    <xacro:property name="M_PI" value="3.1415926535897931" />

    <link name="${prefix}base">
      <inertial>
        <origin xyz="0.0828 0.03604 -7.000000000000001e-05" rpy="0 0 0" />
        <mass value="0.878" />
        <inertia ixx="0.0011546199999999999" ixy="0.0026213200000000003"
          ixz="-5.0899999999999995e-06" iyy="0.00603809" iyz="-2.31e-06" izz="0.0071770900000000006" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/visual/base.glb" />
        </geometry>
      </visual>
      <xacro:if value="${collider_type == 'convex_decomposition'}">
        <collision>
          <geometry>
            <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/convex_decomposition/base_link_convex_decomposition.stl" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collider_type == 'simple'}">
        <collision>
          <geometry>
            <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/convex/base_link.stl" />
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <link name="${prefix}link1">
      <inertial>
        <origin xyz="0.01927 -0.00066 -0.00023999999999999998" rpy="0 0 0" />
        <mass value="0.0312" />
        <inertia ixx="2.53e-06" ixy="3.8e-07" ixz="3e-08" iyy="2.928e-05" iyz="6e-08"
          izz="2.795e-05" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/visual/link1.glb" />
        </geometry>
      </visual>
      <xacro:if value="${collider_type == 'convex_decomposition'}">
        <collision>
          <geometry>
            <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/convex_decomposition/gripper_link1_convex_decomposition.stl" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collider_type == 'simple'}">
        <collision>
          <geometry>
            <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/convex/gripper_link1.stl" />
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <joint name="${prefix}joint" type="revolute">
      <origin xyz="0.12183 -0.02 0" rpy="${M_PI} 0 ${-M_PI/4}" />
      <parent link="${prefix}base" />
      <child link="${prefix}link1" />
      <axis xyz="0 0 -1" />
      <limit lower="0" upper="0.75" velocity="3" effort="2" /> <!-- Tuned opening range
      for
      gripper -->
    </joint>

    <link name="${prefix}link2">
      <inertial>
        <origin xyz="0.02767 -0.0 -0.0" rpy="0 0 0" />
        <mass value="0.0168" />
        <inertia ixx="1.25e-06" ixy="0.0" ixz="0.0" iyy="2.284e-05" iyz="0.0" izz="2.175e-05" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/visual/link2.glb" />
        </geometry>
      </visual>
      <xacro:if value="${collider_type == 'convex_decomposition'}">
        <collision>
          <geometry>
            <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/convex_decomposition/gripper_link2_convex_decomposition.stl" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collider_type == 'simple'}">
        <collision>
          <geometry>
            <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/convex/gripper_link2.stl" />
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <joint name="${prefix}joint2" type="revolute">
      <origin xyz="0.1368 -0.01 0" rpy="${M_PI} 0 ${-M_PI/4}" />
      <parent link="${prefix}base" />
      <child link="${prefix}link2" />
      <axis xyz="0 0 -1" />
      <limit lower="0" upper="0.75" velocity="3" effort="2" /> <!-- Tuned opening range
      for
      gripper -->
      <mimic joint="${prefix}joint" multiplier="1.0"/>
    </joint>

    <link name="${prefix}link3">
      <inertial>
        <origin xyz="0.010320000000000001 -0.00034 0.0" rpy="0 0 0" />
        <mass value="0.026000000000000002" />
        <inertia ixx="1.57e-06" ixy="1.92e-06" ixz="0.0" iyy="1.1380000000000001e-05" iyz="0.0"
          izz="1.176e-05" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/visual/link3.glb" />
        </geometry>
      </visual>
      <xacro:if value="${collider_type == 'convex_decomposition'}">
        <collision>
          <geometry>
            <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/convex_decomposition/gripper_link3_convex_decomposition.stl" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collider_type == 'simple'}">
        <collision>
          <geometry>
            <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/convex/gripper_link3.stl" />
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <joint name="${prefix}joint3" type="revolute">
      <origin xyz="0.065 0 0" rpy="0 0 ${-M_PI/4}" />
      <parent link="${prefix}link2" />
      <child link="${prefix}link3" />
      <axis xyz="0 0 -1" />
      <limit lower="0" upper="0.75" velocity="3" effort="2" /> <!-- Tuned opening range
      for
      gripper -->
      <mimic joint="${prefix}joint" multiplier="-1.0"/>
    </joint>

    <link name="${prefix}link4">
      <inertial>
        <origin xyz="0.01927 0.00066 0.00023999999999999998" rpy="0 0 0" />
        <mass value="0.0312" />
        <inertia ixx="2.53e-06" ixy="3.8e-07" ixz="3e-08" iyy="2.928e-05" iyz="6.5e-08"
          izz="2.795e-05" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/visual/link4.glb" />
        </geometry>
      </visual>
      <xacro:if value="${collider_type == 'convex_decomposition'}">
        <collision>
          <geometry>
            <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/convex_decomposition/gripper_link4_convex_decomposition.stl" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collider_type == 'simple'}">
        <collision>
          <geometry>
            <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/convex/gripper_link4.stl" />
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <joint name="${prefix}joint4" type="revolute">
      <origin xyz="0.121833370678203 0.0199999993241963 0" rpy="${M_PI} 0 ${M_PI/4}" />
      <parent link="${prefix}base" />
      <child link="${prefix}link4" />
      <axis xyz="0 0 -1" />
      <limit lower="0" upper="0.75" velocity="3" effort="2" /> <!-- Tuned opening range
      for
      gripper -->
      <mimic joint="${prefix}joint" multiplier="-1.0"/>
    </joint>

    <link name="${prefix}link5">
      <inertial>
        <origin xyz="0.02767 0.0 0.0" rpy="0 0 0" />
        <mass value="0.0168" />
        <inertia ixx="1.25e-06" ixy="0.0" ixz="0.0" iyy="2.284e-05" iyz="0.0" izz="2.175e-05" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/visual/link5.glb" />
        </geometry>
      </visual>
      <xacro:if value="${collider_type == 'convex_decomposition'}">
        <collision>
          <geometry>
            <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/convex_decomposition/gripper_link5_convex_decomposition.stl" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collider_type == 'simple'}">
        <collision>
          <geometry>
            <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/convex/gripper_link5.stl" />
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <joint name="${prefix}joint5" type="revolute">
      <origin xyz="0.1368 0.01 0" rpy="${M_PI} 0 ${M_PI/4}" />
      <parent link="${prefix}base" />
      <child link="${prefix}link5" />
      <axis xyz="0 0 -1" />
      <limit lower="0" upper="0.75" velocity="3" effort="2" /> <!-- Tuned opening range
      for
      gripper -->
      <mimic joint="${prefix}joint" multiplier="-1.0"/>
    </joint>

    <link name="${prefix}link6">
      <inertial>
        <origin xyz="0.010320000000000001 0.00034 -0.0" rpy="0 0 0" />
        <mass value="0.026000000000000002" />
        <inertia ixx="1.57e-06" ixy="-1.92e-06" ixz="0.0" iyy="1.1380000000000001e-05" iyz="0.0"
          izz="1.176e-05" />
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/visual/link6.glb" />
        </geometry>
      </visual>
      <xacro:if value="${collider_type == 'convex_decomposition'}">
        <collision>
          <geometry>
            <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/convex_decomposition/gripper_link6_convex_decomposition.stl" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collider_type == 'simple'}">
        <collision>
          <geometry>
            <mesh filename="file://$(find hitbot_description)/meshes/Z-EFG-100/convex/gripper_link6.stl" />
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <joint name="${prefix}joint6" type="revolute">
      <origin xyz="0.065 0 0" rpy="0 0 ${M_PI/4}" />
      <parent link="${prefix}link5" />
      <child link="${prefix}link6" />
      <axis xyz="0 0 -1" />
      <limit lower="0" upper="0.75" velocity="3" effort="2" /> <!-- Tuned opening range
      for
      gripper -->
      <mimic joint="${prefix}joint" multiplier="1.0"/>
    </joint>

    <!-- Tool Center Point -->
    <link name="${prefix}tcp_link" />
    <joint name="${prefix}tcp_joint" type="fixed">
      <origin xyz="0.222892 0 0 " rpy="3.14 0 0" />
      <parent link="${prefix}base" />
      <child link="${prefix}tcp_link" />
      <axis xyz="0 0 0" />
    </joint>

  </xacro:macro>
</robot>
