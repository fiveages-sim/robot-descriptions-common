<?xml version="1.0"?>
<robot name="LinkerHand_$(arg type)" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="can_interface" default="can0"/>
    <xacro:arg name="read_tactile" default="false"/>

    <link name="world"/>

    <joint name="world_fixed" type="fixed">
        <parent link="world"/>
        <child link="hand_base"/>
        <origin/>
    </joint>

    <xacro:include filename="$(find linkerhand_description)/xacro/hand.xacro"/>

    <ros2_control name="linkerhand_system" type="system">
        <hardware>
            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </xacro:if>

            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
                <plugin>mock_components/GenericSystem</plugin>
            </xacro:if>

            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
                <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
                <param name="joint_commands_topic">/isaac/joint_command</param>
                <param name="joint_states_topic">/isaac/joint_states</param>
                <param name="sum_wrapped_joint_states">false</param>
                <param name="initialize_commands_from_state">true</param>
            </xacro:if>

            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
                <plugin>modbus_ros2_control/DexterousHandHardware</plugin>
                <param name="serial_port">/dev/ttyUSB0</param>
                <param name="hand_type">linkerhand_$(arg type)</param>
                <xacro:if value="${'$(arg direction)' == '1'}">
                    <param name="hand_side">left</param>
                </xacro:if>
                <xacro:unless value="${'$(arg direction)' == '1'}">
                    <param name="hand_side">right</param>
                </xacro:unless>
                <param name="max_speed_ratio">0.8</param>
            </xacro:if>

            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real_can'}">
                <xacro:if value="${'$(arg type)' == 'o7'}">
                    <plugin>can_ros2_control/O7CanHardware</plugin>
                    <param name="can_interface">$(arg can_interface)</param>
                    <xacro:if value="${'$(arg direction)' == '1'}">
                        <param name="hand_side">left</param>
                    </xacro:if>
                    <xacro:unless value="${'$(arg direction)' == '1'}">
                        <param name="hand_side">right</param>
                    </xacro:unless>
                    <param name="read_feedback">true</param>
                    <param name="read_tactile">$(arg read_tactile)</param>
                    <param name="configure_motion_limits">true</param>
                    <param name="max_velocity_raw">255</param>
                    <param name="max_acceleration_raw">254</param>
                    <param name="velocity_filter_alpha">0.25</param>
                </xacro:if>
            </xacro:if>
        </hardware>

        <!-- Support type: o7, o6, l6, l10 -->
        <xacro:if value="${'$(arg type)' == 'o7'}">
            <xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/o7.xacro"/>
            <xacro:linkerhand_o7_interfaces name=""/>
        </xacro:if>
        <xacro:if value="${'$(arg type)' == 'o6' or '$(arg type)' == 'l6'}">
            <xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/o6.xacro"/>
            <xacro:linkerhand_o6_interfaces name=""/>
        </xacro:if>
        <xacro:if value="${'$(arg type)' == 'l10'}">
            <xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/l10.xacro"/>
            <xacro:linkerhand_l10_interfaces name=""/>
        </xacro:if>
    </ros2_control>

    <xacro:arg name="gazebo" default="false"/>
    <xacro:if value="$(arg gazebo)">
        <gazebo>
            <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <parameters>$(find linkerhand_description)/config/ros2_control/ros2_controllers.yaml</parameters>
            </plugin>
        </gazebo>
    </xacro:if>
</robot>
