				<inertia ixx="0.00483124658726801" ixy="${direction*-0.000120079243984}" ixz="2.7699838991495E-05"
				         iyy="0.00363360625618824" iyz="${direction*0.000130624066360049}" izz="0.00244702121245661"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find freedom_description)/meshes/freedomv2/hand_base.glb"
					      scale="1 ${direction} 1"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find freedom_description)/meshes/freedomv2/hand_base.glb"
					      scale="1 ${direction} 1"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}p_joint1" type="fixed">
			<origin xyz="0 0 0.009" />
			<parent link="${prefix}hand_base"/>
			<child link="${prefix}p_link1"/>
