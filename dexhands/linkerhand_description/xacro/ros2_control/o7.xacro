<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- LinkerHand O7 灵巧手接口定义宏 -->
  <xacro:macro name="linkerhand_o7_interfaces" params="name">
    <xacro:arg name="gazebo" default="false"/>
    <xacro:property name="prefix" value="${name + '_' if name else ''}"/>
    
    <!-- 7个主控关节接口定义 -->
    <!-- 拇指关节 -->
    <joint name="${prefix}thumb_joint1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <xacro:unless value="${'$(arg ros2_control_hardware_type)' == 'real_can'}">
        <state_interface name="effort"/>
      </xacro:unless>
    </joint>

    <joint name="${prefix}thumb_joint2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <xacro:unless value="${'$(arg ros2_control_hardware_type)' == 'real_can'}">
        <state_interface name="effort"/>
      </xacro:unless>
    </joint>

    <joint name="${prefix}thumb_joint3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <xacro:unless value="${'$(arg ros2_control_hardware_type)' == 'real_can'}">
        <state_interface name="effort"/>
      </xacro:unless>
    </joint>

    <!-- 食指关节 -->
    <joint name="${prefix}index_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <xacro:unless value="${'$(arg ros2_control_hardware_type)' == 'real_can'}">
        <state_interface name="effort"/>
      </xacro:unless>
    </joint>

    <!-- 中指关节 -->
    <joint name="${prefix}middle_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <xacro:unless value="${'$(arg ros2_control_hardware_type)' == 'real_can'}">
        <state_interface name="effort"/>
      </xacro:unless>
    </joint>

    <!-- 无名指关节 -->
    <joint name="${prefix}ring_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <xacro:unless value="${'$(arg ros2_control_hardware_type)' == 'real_can'}">
        <state_interface name="effort"/>
      </xacro:unless>
    </joint>

    <!-- 小指关节 -->
    <joint name="${prefix}pinky_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <xacro:unless value="${'$(arg ros2_control_hardware_type)' == 'real_can'}">
        <state_interface name="effort"/>
      </xacro:unless>
    </joint>

    <xacro:if value="$(arg gazebo)">
      <!-- Gazebo 仿真中的 mimic 关节接口（仅状态接口，用于可视化） -->
      <joint name="${prefix}thumb_mcp">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}thumb_ip">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}index_pip">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}index_dip">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}middle_pip">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}middle_dip">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}ring_pip">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}ring_dip">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}pinky_pip">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}pinky_dip">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:if>
  </xacro:macro>

</robot>
