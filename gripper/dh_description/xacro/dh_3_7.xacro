                    <material name="${prefix}dh_3_7_material">
                        <color rgba="0.75294 0.75294 0.75294 1" />
                    </material>
                </visual>
                <collision>
                    <origin xyz="0 0 0" rpy="0 0 0" />
                    <geometry>
                        <mesh filename="file://$(find dh_description)/meshes/dh_3_7/right/F32_Link.STL" />
                    </geometry>
                </collision>
            </link>
            <joint name="${prefix}middle_joint2" type="${joint_type}">
                <origin xyz="3E-05 0.057 0" rpy="0 0 0" />
                <parent link="${prefix}hand_middle_link1" />
                <child link="${prefix}hand_middle_link2" />
                <xacro:unless value="${is_fixed}">
                    <axis xyz="1 0 0" />
                    <limit lower="0" upper="3.51" effort="10" velocity="5" />
                    <dynamics damping="0.1" friction="10" />
                </xacro:unless>
            </joint>
        </xacro:if>
    </xacro:macro>
</robot>
