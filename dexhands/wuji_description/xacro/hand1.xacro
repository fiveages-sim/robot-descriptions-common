    </link>
    <joint name="${prefix}finger2_joint3" type="${joint_type}">
      <origin xyz="0 0.004749999 0.04361769" rpy="0 0 -1.570528"/>
      <parent link="${prefix}finger2_link2"/>
      <child link="${prefix}finger2_link3"/>
      <xacro:unless value="${fixed_joints}">
        <axis xyz="0 1 0"/>
        <limit lower="-0.4777" upper="1.5485" effort="0.2251" velocity="12.863"/>
      </xacro:unless>
    </joint>
