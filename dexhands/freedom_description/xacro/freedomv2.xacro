<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:macro name="FreedomHandV2" params="name direction:=1 fixed_joints:=false">
		<xacro:property name="prefix" value="${name + '_' if name else ''}"/>
		<xacro:property name="joint_type" value="${fixed_joints and 'fixed' or 'revolute'}"/>

		<link name="${prefix}hand_base">
			<inertial>
				<origin xyz="1.72456639246921E-10 0.000159743547726118 0.00658240409197629" />
				<mass value="0.0176998254464378"/>
				<inertia ixx="4.77814014865034E-06" ixy="-2.8287088790031E-15" ixz="-1.75792865725827E-14"
				         iyy="4.84927762663746E-06" iyz="4.47414433687868E-09" izz="9.23717647630549E-06"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find freedom_description)/meshes/freedomv2/flange.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find freedom_description)/meshes/freedomv2/flange.glb"/>
				</geometry>
			</collision>
		</link>

		<link name="${prefix}p_link1">
			<inertial>
				<origin xyz="-0.000806915097716 ${direction*0.00388610492404} 0.0525721443156" />
