			<child link="${prefix}thumb_link2"/>
			<origin xyz="0 0 0" rpy="1.5708 ${direction*1.5708} 0"/>
			<axis xyz="0 0 ${direction}"/>
			<limit lower="0" upper="1.5708" effort="0" velocity="0"/>
		</joint>
		<link name="${prefix}thumb_link2">
