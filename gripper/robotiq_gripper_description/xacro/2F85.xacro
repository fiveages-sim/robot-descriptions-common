<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    FaSim wrapper around official robotiq_description 2F-85 meshes/kinematics.
    Exposes gripper_base + gripper_joint (with optional name prefix).
    collider:=convex|simple — planning uses simple envelope (OCS2 self-collision).
    kinematic_only:=true — omit finger DOF links; keep base envelope + eef (planning).
  -->
  <xacro:arg name="collider" default="convex"/>
  <xacro:property name="collider_type" value="$(arg collider)"/>

  <!-- Planning envelope in gripper_base (+Z toward fingers / eef at z=0.15). -->
  <xacro:macro name="Robotiq85_simple_collision">
    <xacro:if value="${collider_type == 'simple'}">
      <!-- body + open-finger stroke envelope along tool Z -->
      <collision>
        <origin xyz="0 0 0.075"/>
        <geometry>
          <cylinder length="0.15" radius="0.055"/>
        </geometry>
      </collision>
      <!-- lateral knuckle/finger width when open -->
      <collision>
        <origin xyz="0 0 0.07"/>
        <geometry>
          <box size="0.12 0.04 0.10"/>
        </geometry>
      </collision>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="Robotiq85" params="name kinematic_only:=false">
    <xacro:property name="prefix" value="${name + '_' if name else ''}"/>

    <link name="${prefix}gripper_base">
      <visual>
        <geometry>
          <mesh filename="file://$(find robotiq_description)/meshes/visual/robotiq_base.dae"/>
        </geometry>
      </visual>
      <xacro:if value="${collider_type == 'convex'}">
        <collision>
          <geometry>
            <mesh filename="file://$(find robotiq_description)/meshes/collision/robotiq_base.stl"/>
          </geometry>
        </collision>
      </xacro:if>
      <xacro:Robotiq85_simple_collision/>
      <inertial>
        <origin xyz="0.0 2.274e-05 0.03232288" rpy="0 0 0"/>
        <mass value="6.6320197e-01"/>
        <inertia ixx="5.1617816e-04" iyy="5.8802208e-04" izz="3.9462776e-04" ixy="2.936e-8" ixz="0.0" iyz="-3.2296e-7"/>
      </inertial>
    </link>

    <!-- Planning: omit finger DOF; envelope already on gripper_base. -->
    <xacro:unless value="${str(kinematic_only).lower() == 'true'}">
      <link name="${prefix}left_outer_knuckle">
        <visual>
          <geometry>
            <mesh filename="file://$(find robotiq_description)/meshes/visual/left_knuckle.dae"/>
          </geometry>
        </visual>
        <xacro:if value="${collider_type == 'convex'}">
          <collision>
            <geometry>
              <mesh filename="file://$(find robotiq_description)/meshes/collision/left_knuckle.stl"/>
            </geometry>
          </collision>
        </xacro:if>
        <xacro:if value="${collider_type == 'simple'}">
          <collision>
            <origin xyz="0.01 0 0"/>
            <geometry>
              <box size="0.03 0.02 0.03"/>
            </geometry>
          </collision>
        </xacro:if>
        <inertial>
          <origin xyz="0.01213197 0.0002 -0.00058647" rpy="0 0 0"/>
          <mass value="1.384773208e-02"/>
          <inertia ixx="3.5232e-7" iyy="2.31944e-6" izz="2.23136e-6" ixy="0.0" ixz="1.1744e-7" iyz="0"/>
        </inertial>
      </link>

      <link name="${prefix}right_outer_knuckle">
        <visual>
          <geometry>
            <mesh filename="file://$(find robotiq_description)/meshes/visual/right_knuckle.dae"/>
          </geometry>
        </visual>
        <xacro:if value="${collider_type == 'convex'}">
          <collision>
            <geometry>
              <mesh filename="file://$(find robotiq_description)/meshes/collision/right_knuckle.stl"/>
            </geometry>
          </collision>
        </xacro:if>
        <xacro:if value="${collider_type == 'simple'}">
          <collision>
            <origin xyz="-0.01 0 0"/>
            <geometry>
              <box size="0.03 0.02 0.03"/>
            </geometry>
          </collision>
        </xacro:if>
        <inertial>
          <origin xyz="-0.01213197 0.0002 -0.00058647" rpy="0 0 0"/>
          <mass value="1.384773208e-02"/>
          <inertia ixx="3.5232e-7" iyy="2.31944e-6" izz="2.23136e-6" ixy="0.0" ixz="-1.1744e-7" iyz="0.0"/>
        </inertial>
      </link>

      <link name="${prefix}left_outer_finger">
        <visual>
          <geometry>
            <mesh filename="file://$(find robotiq_description)/meshes/visual/left_finger.dae"/>
          </geometry>
        </visual>
        <xacro:if value="${collider_type == 'convex'}">
          <collision>
            <geometry>
              <mesh filename="file://$(find robotiq_description)/meshes/collision/left_finger.stl"/>
            </geometry>
          </collision>
        </xacro:if>
        <xacro:if value="${collider_type == 'simple'}">
          <collision>
            <origin xyz="0.015 0 0"/>
            <geometry>
              <box size="0.04 0.02 0.025"/>
            </geometry>
          </collision>
        </xacro:if>
        <inertial>
          <origin xyz="0.00346899 -0.00079447 0.01867121" rpy="0 0 0"/>
          <mass value="4.260376752e-02"/>
          <inertia ixx="1.385792e-05" iyy="1.183208e-05" izz="5.19672e-06" ixy="0.0" ixz="-2.17264e-06" iyz="0.0"/>
        </inertial>
      </link>

      <link name="${prefix}right_outer_finger">
        <visual>
          <geometry>
            <mesh filename="file://$(find robotiq_description)/meshes/visual/right_finger.dae"/>
          </geometry>
        </visual>
        <xacro:if value="${collider_type == 'convex'}">
          <collision>
            <geometry>
              <mesh filename="file://$(find robotiq_description)/meshes/collision/right_finger.stl"/>
            </geometry>
          </collision>
        </xacro:if>
        <xacro:if value="${collider_type == 'simple'}">
          <collision>
            <origin xyz="-0.015 0 0"/>
            <geometry>
              <box size="0.04 0.02 0.025"/>
            </geometry>
          </collision>
        </xacro:if>
        <inertial>
          <origin xyz="-0.00346899 -5.53e-06 0.01867121" rpy="0 0 0"/>
          <mass value="4.260376752e-02"/>
          <inertia ixx="1.385792e-05" iyy="1.183208e-05" izz="5.19672e-06" ixy="0.0" ixz="2.17264e-06" iyz="0.0"/>
        </inertial>
      </link>

      <link name="${prefix}left_inner_knuckle">
        <visual>
          <geometry>
            <mesh filename="file://$(find robotiq_description)/meshes/visual/left_inner_knuckle.dae"/>
          </geometry>
        </visual>
        <xacro:if value="${collider_type == 'convex'}">
          <collision>
            <geometry>
              <mesh filename="file://$(find robotiq_description)/meshes/collision/left_inner_knuckle.stl"/>
            </geometry>
          </collision>
        </xacro:if>
        <inertial>
          <origin xyz="0.01897699 0.00015001 0.02247101" rpy="0 0 0"/>
          <mass value="2.969376448e-02"/>
          <inertia ixx="9.57136e-06" iyy="8.69056e-06" izz="8.19144e-06" ixy="0.0" ixz="-3.93424e-06" iyz="0.0"/>
        </inertial>
      </link>

      <link name="${prefix}right_inner_knuckle">
        <visual>
          <geometry>
            <mesh filename="file://$(find robotiq_description)/meshes/visual/right_inner_knuckle.dae"/>
          </geometry>
        </visual>
        <xacro:if value="${collider_type == 'convex'}">
          <collision>
            <geometry>
              <mesh filename="file://$(find robotiq_description)/meshes/collision/right_inner_knuckle.stl"/>
            </geometry>
          </collision>
        </xacro:if>
        <inertial>
          <origin xyz="-0.01926824 5.001e-05 0.02222178" rpy="0 0 0"/>
          <mass value="2.969376448e-02"/>
          <inertia ixx="9.42456e-06" iyy="8.69056e-06" izz="8.33824e-06" ixy="0.0" ixz="3.9636e-06" iyz="0.0"/>
        </inertial>
      </link>

      <link name="${prefix}left_inner_finger">
        <visual>
          <geometry>
            <mesh filename="file://$(find robotiq_description)/meshes/visual/left_finger_tip.dae"/>
          </geometry>
        </visual>
        <xacro:if value="${collider_type == 'convex'}">
          <collision>
            <geometry>
              <mesh filename="file://$(find robotiq_description)/meshes/collision/left_finger_tip.stl"/>
            </geometry>
          </collision>
        </xacro:if>
        <xacro:if value="${collider_type == 'simple'}">
          <collision>
            <origin xyz="0 0 0.01"/>
            <geometry>
              <box size="0.025 0.02 0.035"/>
            </geometry>
          </collision>
        </xacro:if>
        <inertial>
          <origin xyz="-0.01456706 -0.0008 0.01649701" rpy="0 0 0"/>
          <mass value="4.268588744e-02"/>
          <inertia ixx="1.048152e-05" iyy="1.197888e-05" izz="4.22784e-06" ixy="0.0" ixz="3.5232e-6" iyz="0.0"/>
        </inertial>
      </link>

      <link name="${prefix}right_inner_finger">
        <visual>
          <geometry>
            <mesh filename="file://$(find robotiq_description)/meshes/visual/right_finger_tip.dae"/>
          </geometry>
        </visual>
        <xacro:if value="${collider_type == 'convex'}">
          <collision>
            <geometry>
              <mesh filename="file://$(find robotiq_description)/meshes/collision/right_finger_tip.stl"/>
            </geometry>
          </collision>
        </xacro:if>
        <xacro:if value="${collider_type == 'simple'}">
          <collision>
            <origin xyz="0 0 0.01"/>
            <geometry>
              <box size="0.025 0.02 0.035"/>
            </geometry>
          </collision>
        </xacro:if>
        <inertial>
          <origin xyz="0.01456706 5e-05 0.01649701" rpy="0 0 0"/>
          <mass value="4.268588744e-02"/>
          <inertia ixx="1.048152e-05" iyy="1.197888e-05" izz="4.22784e-06" ixy="0.0" ixz="-3.5232e-06" iyz="0.0"/>
        </inertial>
      </link>

      <!-- Actuated joint (maps from official robotiq_85_left_knuckle_joint) -->
      <joint name="${prefix}gripper_joint" type="revolute">
        <parent link="${prefix}gripper_base"/>
        <child link="${prefix}left_outer_knuckle"/>
        <axis xyz="0 -1 0"/>
        <origin xyz="0.03060114 0.0 0.05490452" rpy="0 0 0"/>
        <limit lower="0.0" upper="0.8" velocity="0.5" effort="50"/>
      </joint>

      <joint name="${prefix}right_outer_knuckle_joint" type="revolute">
        <parent link="${prefix}gripper_base"/>
        <child link="${prefix}right_outer_knuckle"/>
        <axis xyz="0 -1 0"/>
        <origin xyz="-0.03060114 0.0 0.05490452" rpy="0 0 0"/>
        <limit lower="-0.8" upper="0.0" velocity="0.5" effort="50"/>
        <mimic joint="${prefix}gripper_joint" multiplier="-1"/>
      </joint>

      <joint name="${prefix}left_outer_finger_joint" type="fixed">
        <parent link="${prefix}left_outer_knuckle"/>
        <child link="${prefix}left_outer_finger"/>
        <origin xyz="0.03152616 0.0 -0.00376347" rpy="0 0 0"/>
      </joint>

      <joint name="${prefix}right_outer_finger_joint" type="fixed">
        <parent link="${prefix}right_outer_knuckle"/>
        <child link="${prefix}right_outer_finger"/>
        <origin xyz="-0.03152616 0.0 -0.00376347" rpy="0 0 0"/>
      </joint>

      <joint name="${prefix}left_inner_knuckle_joint" type="continuous">
        <parent link="${prefix}gripper_base"/>
        <child link="${prefix}left_inner_knuckle"/>
        <axis xyz="0 -1 0"/>
        <origin xyz="0.0127 0.0 0.06142" rpy="0 0 0"/>
        <mimic joint="${prefix}gripper_joint"/>
      </joint>

      <joint name="${prefix}right_inner_knuckle_joint" type="continuous">
        <parent link="${prefix}gripper_base"/>
        <child link="${prefix}right_inner_knuckle"/>
        <axis xyz="0 -1 0"/>
        <origin xyz="-0.0127 0.0 0.06142" rpy="0 0 0"/>
        <mimic joint="${prefix}gripper_joint" multiplier="-1"/>
      </joint>

      <joint name="${prefix}left_inner_finger_joint" type="continuous">
        <parent link="${prefix}left_outer_finger"/>
        <child link="${prefix}left_inner_finger"/>
        <axis xyz="0 -1 0"/>
        <origin xyz="0.00563134 0.0 0.04718515" rpy="0 0 0"/>
        <mimic joint="${prefix}gripper_joint" multiplier="-1"/>
      </joint>

      <joint name="${prefix}right_inner_finger_joint" type="continuous">
        <parent link="${prefix}right_outer_finger"/>
        <child link="${prefix}right_inner_finger"/>
        <axis xyz="0 -1 0"/>
        <origin xyz="-0.00563134 0.0 0.04718515" rpy="0 0 0"/>
        <mimic joint="${prefix}gripper_joint"/>
      </joint>
    </xacro:unless>

    <link name="${prefix}eef"/>
    <joint name="${prefix}eef_joint" type="fixed">
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}eef"/>
      <origin xyz="0 0 0.15"/>
    </joint>
  </xacro:macro>
</robot>
