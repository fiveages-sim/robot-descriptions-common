<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:macro name="TheoHandStd16A" params="name direction:=1 fixed_joints:=false">
		<xacro:property name="prefix" value="${name + '_' if name else ''}"/>
		<link name="${prefix}hand_base"/>
		<joint name="${prefix}hand_base_fixed" type="fixed">
			<parent link="${prefix}hand_base"/>
			<child link="${prefix}base_link"/>
			
		</joint>
		<link name="${prefix}base_link">
			<visual>
				
				<geometry>
					<mesh filename="file://$(find theohand_description)/meshes/std16a/base.glb"
								scale="1 ${-direction} 1"/>
				</geometry>
			</visual>
			<collision>
				
				<geometry>
					<mesh filename="file://$(find theohand_description)/meshes/std16a/base.glb"
								scale="1 ${-direction} 1"/>
				</geometry>
			</collision>
			<inertial>
				<origin xyz="-0.00381424636269485 0.00207802750628399 0.0762957680404765" rpy="0 0 0"/>
				<mass value="0.57109497006203"/>
				<inertia ixx="0.000373948529416664"
								 ixy="-6.49325357222745E-06"
								 ixz="-1.39657450668528E-05"
								 iyy="0.000648700813496535"
								 iyz="-4.7759577399386E-07"
								 izz="0.000385655630526283"/>
			</inertial>
		</link>
		<link name="${prefix}eef"/>
		<joint name="${prefix}eef_joint" type="fixed">
			<parent link="${prefix}base_link"/>
			<child link="${prefix}eef"/>
			<origin xyz="0.03 0 0.1"/>
		</joint>
		<joint name="${prefix}thumb_joint1" type="prismatic">
			<parent link="${prefix}base_link"/>
			<child link="${prefix}thumb_link1"/>
			<origin xyz="0.0305 ${direction*0.0002} ${0.049825 + direction*0.001475}" rpy="-1.5708 0 -1.5708"/>
			<axis xyz="0 0 -1"/>
			<limit lower="-0.001" upper="0.04" effort="0" velocity="0"/>
		</joint>
		<link name="${prefix}thumb_link1">
			<visual>
				
				<geometry>
					<mesh filename="file://$(find theohand_description)/meshes/std16a/thumb_link1.glb"
								scale="1 1 ${-direction}"/>
				</geometry>
			</visual>
			<collision>
				
				<geometry>
					<mesh filename="file://$(find theohand_description)/meshes/std16a/thumb_link1.glb"
