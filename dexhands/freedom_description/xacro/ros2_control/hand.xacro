<?xml version="1.0"?>
<robot name="Freedom_$(arg type)" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="type" default="freedom"/>
    <xacro:arg name="direction" default="1"/>
    <xacro:arg name="gazebo" default="false"/>
    <xacro:arg name="serial_port" default="/dev/ttyACM0"/>
    <xacro:arg name="slave_id" default="auto"/>
    <xacro:arg name="baudrate" default="115200"/>
    <xacro:arg name="can_interface" default="can0"/>
    <xacro:arg name="device_id" default="auto"/>

    <link name="world"/>

    <joint name="world_fixed" type="fixed">
        <parent link="world"/>
        <child link="hand_base"/>
        <origin/>
    </joint>

    <xacro:include filename="$(find freedom_description)/xacro/hand.xacro"/>

    <ros2_control name="freedom_system" type="system">
        <hardware>
            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </xacro:if>

            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
                <plugin>mock_components/GenericSystem</plugin>
            </xacro:if>

            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
                <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
                <param name="joint_commands_topic">/isaac/joint_command</param>
                <param name="joint_states_topic">/isaac/joint_states</param>
                <param name="sum_wrapped_joint_states">false</param>
                <param name="initialize_commands_from_state">true</param>
            </xacro:if>

            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
                <plugin>modbus_ros2_control/FreedomRS485Hardware</plugin>
                <param name="serial_port">$(arg serial_port)</param>
                <param name="slave_id">$(arg slave_id)</param>
                <xacro:if value="${'$(arg direction)' == '1'}">
                    <param name="hand_side">left</param>
                </xacro:if>
                <xacro:unless value="${'$(arg direction)' == '1'}">
                    <param name="hand_side">right</param>
                </xacro:unless>
                <param name="baudrate">$(arg baudrate)</param>
                <param name="read_feedback">true</param>
                <param name="feedback_timeout_ms">20</param>
            </xacro:if>

            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real_can'}">
                <plugin>can_ros2_control/FreedomCanHardware</plugin>
                <param name="can_interface">$(arg can_interface)</param>
                <xacro:if value="${'$(arg device_id)' == 'auto' and '$(arg direction)' == '1'}">
                    <param name="device_id">0</param>
                </xacro:if>
                <xacro:if value="${'$(arg device_id)' == 'auto' and '$(arg direction)' != '1'}">
                    <param name="device_id">1</param>
                </xacro:if>
                <xacro:if value="${'$(arg device_id)' != 'auto'}">
                    <param name="device_id">$(arg device_id)</param>
                </xacro:if>
                <param name="read_feedback">true</param>
                <param name="feedback_timeout_ms">1</param>
            </xacro:if>
        </hardware>

        <xacro:include filename="$(find freedom_description)/xacro/ros2_control/freedom.xacro"/>
        <xacro:freedom_interfaces name=""/>
    </ros2_control>

    <xacro:arg name="gazebo" default="false"/>
    <xacro:if value="$(arg gazebo)">
        <gazebo>
            <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <parameters>$(find freedom_description)/config/ros2_control/ros2_controllers.yaml</parameters>
            </plugin>
        </gazebo>
    </xacro:if>
</robot>
