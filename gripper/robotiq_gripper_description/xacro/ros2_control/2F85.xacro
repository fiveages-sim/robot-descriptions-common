<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Robotiq 2F85 接口：主动关节 gripper_joint，mimic 关节仅状态 -->
  <xacro:macro name="robotiq_2f85_interfaces" params="name">
    <xacro:property name="prefix" value="${name + '_' if name else ''}"/>

    <joint name="${prefix}gripper_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <!-- 关闭位≈upper(0.8)；adaptive_gripper 据此推断 closed/open，勿写成 0 -->
        <param name="initial_value">0.8</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="${prefix}right_outer_knuckle_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="${prefix}left_inner_knuckle_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="${prefix}right_inner_knuckle_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="${prefix}left_inner_finger_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="${prefix}right_inner_finger_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

</robot>
