    </link>
    <joint name="${prefix}finger1_joint4" type="${joint_type}">
      <origin xyz="0 ${direction*-0.0002} 0.0295" rpy="0 0 0"/>
      <parent link="${prefix}finger1_link3"/>
      <child link="${prefix}finger1_link4"/>
      <xacro:unless value="${fixed_joints}">
        <axis xyz="0 1 0"/>
        <limit lower="-0.4699" upper="1.5568" effort="0.1468" velocity="13.578"/>
