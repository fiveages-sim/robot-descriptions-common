<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:property name="PI" value="3.1415926535897931"/>

	<xacro:macro name="passive_wheel" params="parent_link passive_wheel_name radius angle sphere_radius:='0.06'">
		<link name="${passive_wheel_name}">
			<inertial>
				<origin xyz="0 0 0"/>
				<mass value="0.01"/>
				<inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
			</inertial>
			<collision>
				<geometry>
					<sphere radius="${float(sphere_radius)}"/>
				</geometry>
			</collision>
		</link>

		<joint name="${passive_wheel_name}_joint" type="continuous">
			<origin xyz="0.0385 ${float(radius) * cos(float(angle))} ${float(radius) * sin(float(angle))}"
							rpy="${float(angle)} 0 0"/>
			<parent link="${parent_link}"/>
			<child link="${passive_wheel_name}"/>
			<axis xyz="0 0 1"/>
		</joint>
	</xacro:macro>

	<xacro:macro name="create_passive_wheels"
							 params="parent_link wheel_name indices:=^ angle_step passive_wheel_radius_actual">
		<xacro:if value="${indices}">
			<xacro:property name="index" value="${indices.pop(0)}"/>
			<xacro:property name="angle" value="${float(index) * float(angle_step)}"/>

			<xacro:passive_wheel
					parent_link="${parent_link}"
					passive_wheel_name="${wheel_name}_passive_${index}"
					radius="${passive_wheel_radius_actual}"
					angle="${angle}"/>

			<xacro:create_passive_wheels
					parent_link="${parent_link}"
					wheel_name="${wheel_name}"
					indices="${indices}"
					angle_step="${angle_step}"
					passive_wheel_radius_actual="${passive_wheel_radius_actual}"/>
		</xacro:if>
	</xacro:macro>

	<xacro:macro name="wheel" params="wheel_name
                                    enable_passive_wheels:='false'
                                    passive_wheel_radius:='0.02'
                                    num_passive_wheels:='9'">
		<link name="${wheel_name}">
			<inertial>
				<origin xyz="0.035966 2.6831E-06 8.693E-07"/>
				<mass value="0.5746"/>
				<inertia
						ixx="0.00142306"
						ixy="0.00000000"
						ixz="0.00000000"
						iyy="0.00084449"
						iyz="0.00000002"
						izz="0.00084474"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find component_models)/meshes/omnia_150.glb"/>
				</geometry>
			</visual>
		</link>

		<xacro:if value="${enable_passive_wheels}">
			<xacro:property name="num_passive_wheels_float" value="${float(num_passive_wheels)}"/>
			<xacro:property name="angle_step" value="${2*PI / num_passive_wheels_float}"/>
			<xacro:property name="indices" value="${[0,1,2,3,4,5,6,7,8]}"/>
			<xacro:create_passive_wheels
					parent_link="${wheel_name}"
					wheel_name="${wheel_name}"
					indices="${list(indices)}"
					angle_step="${angle_step}"
					passive_wheel_radius_actual="${passive_wheel_radius}"/>
		</xacro:if>
	</xacro:macro>
</robot>