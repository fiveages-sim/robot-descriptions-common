				         iyy="1.03628901393644E-05" iyz="${direction*1.23048408364082E-09}" izz="1.02475178499253E-05"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find freedom_description)/meshes/freedomv2/index_link3.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find freedom_description)/meshes/freedomv2/index_link3.glb"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}pinky_dip" type="${joint_type}">
			<origin xyz="0.032003 -0.0025 0" rpy="0 0 0.41015"/>
			<parent link="${prefix}f_link5_2"/>
			<child link="${prefix}f_link5_3"/>
			<xacro:unless value="${fixed_joints}">
				<axis xyz="0 0 1"/>
				<limit lower="0" upper="1.204" effort="10" velocity="1.5"/>
				<mimic joint="${prefix}pinky_joint" multiplier="0.8625" offset="0"/>
			</xacro:unless>
		</joint>

		<link name="${prefix}eef"/>
		<joint name="${prefix}eef_joint" type="fixed">
			<parent link="${prefix}hand_base"/>
			<child link="${prefix}eef"/>
			<origin xyz="0.02 0 0.07"/>
		</joint>
	</xacro:macro>

</robot>
