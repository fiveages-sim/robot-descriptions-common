<?xml version="1.0"?>
<robot name="InspireHand_$(arg type)" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="name" default=""/>
  <xacro:arg name="type" default="RH56E2"/>
  <xacro:arg name="direction" default="1"/>
  <xacro:arg name="gazebo" default="false"/>
  <xacro:arg name="serial_port" default="/dev/ttyUSB0"/>
  <xacro:arg name="baudrate" default="115200"/>
  <xacro:arg name="can_interface" default="can0"/>
  <xacro:arg name="read_feedback" default="true"/>

  <xacro:include filename="$(find inspire_description)/xacro/hand.xacro"/>

  <ros2_control name="inspire_hand_system" type="system">
    <hardware>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
        <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
        <param name="joint_commands_topic">/isaac/joint_command</param>
        <param name="joint_states_topic">/isaac/joint_states</param>
        <param name="sum_wrapped_joint_states">false</param>
        <param name="initialize_commands_from_state">true</param>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <plugin>modbus_ros2_control/InspireHandHardware</plugin>
        <param name="serial_port">$(arg serial_port)</param>
        <param name="baudrate">$(arg baudrate)</param>
        <xacro:if value="${$(arg direction) == 1}">
          <param name="hand_side">left</param>
        </xacro:if>
        <xacro:if value="${$(arg direction) == -1}">
          <param name="hand_side">right</param>
        </xacro:if>
        <param name="read_feedback">$(arg read_feedback)</param>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real_can'}">
        <plugin>can_ros2_control/InspireCanfdHardware</plugin>
        <param name="can_interface">$(arg can_interface)</param>
        <xacro:if value="${$(arg direction) == 1}">
          <param name="hand_side">left</param>
        </xacro:if>
        <xacro:if value="${$(arg direction) == -1}">
          <param name="hand_side">right</param>
        </xacro:if>
        <param name="read_feedback">$(arg read_feedback)</param>
        <param name="feedback_timeout_ms">2</param>
      </xacro:if>
    </hardware>

    <xacro:if value="${'$(arg type)' == 'RH56E2'}">
      <xacro:include filename="$(find inspire_description)/xacro/ros2_control/RH56E2.xacro"/>
      <xacro:inspire_rh56e2_interfaces name="$(arg name)" direction="$(arg direction)"/>
    </xacro:if>

    <xacro:if value="${'$(arg type)' == 'RH56F2'}">
      <xacro:include filename="$(find inspire_description)/xacro/ros2_control/RH56F2.xacro"/>
      <xacro:inspire_rh56f2_interfaces name="$(arg name)" direction="$(arg direction)"/>
    </xacro:if>
  </ros2_control>

  <xacro:if value="$(arg gazebo)">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find inspire_description)/config/ros2_control/ros2_controllers.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
