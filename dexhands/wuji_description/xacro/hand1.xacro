<?xml version="1.0" encoding="utf-8"?>
<!--
  Wuji Hand (gen1 / hand1): single-tree + direction mirroring.
  Source: wuji-description/hand/body left/right ROS URDFs.
  finger1_joint2/3: rpy ternary (required); xyz/axis per official L/R.
  Meshes: meshes/hand1/{left,right}/ side STL (no Y-scale); finger2-5 share digit_*.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="WujiHand" params="name direction:=1 use_mount:=false fixed_joints:=false">
    <xacro:property name="prefix" value="${name + '_' if name else ''}"/>
    <xacro:property name="joint_type" value="${fixed_joints and 'fixed' or 'revolute'}"/>
    <xacro:property name="mesh_side" value="${'left' if direction == 1 else 'right'}"/>
    <!-- use_mount ignored: gen1 has no mount link; meshes: side STL, no Y-scale -->

    <link name="${prefix}hand_base">
      <inertial>
        <origin xyz="-0.002979471 ${direction*-0.0004557176} 0.03665409" rpy="0 0 0"/>
        <mass value="0.16914"/>
        <inertia ixx="0.00014" ixy="${direction*-2.54e-06}" ixz="6.9100000000e-06" iyy="9.4700000000e-05" iyz="${direction*6.63e-06}" izz="6.0000000000e-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find wuji_description)/meshes/hand1/${mesh_side}/${mesh_side}_palm_link.STL"/>
        </geometry>
        <material name="">
          <color rgba="0.627451 0.627451 0.627451 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find wuji_description)/meshes/hand1/${mesh_side}/${mesh_side}_palm_link.STL"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}finger1_link1">
      <inertial>
        <origin xyz="-0.002466361 ${direction*0.001243356} 0.007796453" rpy="0 0 0"/>
        <mass value="0.0075"/>
        <inertia ixx="3.2e-07" ixy="${direction*-2e-08}" ixz="0" iyy="3e-07" iyz="${direction*4e-08}" izz="2.3e-07"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find wuji_description)/meshes/hand1/${mesh_side}/${mesh_side}_finger1_link1.STL"/>
        </geometry>
        <material name="">
          <color rgba="0.627451 0.627451 0.627451 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find wuji_description)/meshes/hand1/${mesh_side}/${mesh_side}_finger1_link1.STL"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}finger1_joint1" type="${joint_type}">
      <origin xyz="0.0084399 ${direction*-0.020587} 0.028893" rpy="${direction*1.328} -0.37161 ${direction*0.7307}"/>
      <parent link="${prefix}hand_base"/>
      <child link="${prefix}finger1_link1"/>
      <xacro:unless value="${fixed_joints}">
        <axis xyz="0 1 0"/>
        <limit lower="0.0475" upper="1.6033" effort="0.4452" velocity="8.587"/>
      </xacro:unless>
    </joint>
    <link name="${prefix}finger1_link2">
      <inertial>
        <origin xyz="0.001165924 ${direction*1.466029e-05} 0.01565596" rpy="0 0 0"/>
        <mass value="0.0248"/>
        <inertia ixx="2.76e-06" ixy="${direction*2e-08}" ixz="1e-08" iyy="2.81e-06" iyz="${direction*2e-08}" izz="6.8e-07"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find wuji_description)/meshes/hand1/${mesh_side}/${mesh_side}_finger1_link2.STL"/>
        </geometry>
        <material name="">
          <color rgba="0.627451 0.627451 0.627451 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find wuji_description)/meshes/hand1/${mesh_side}/${mesh_side}_finger1_link2.STL"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}finger1_joint2" type="${joint_type}">
      <origin xyz="-0.0047549 ${direction*0.0058191} 0.014132" rpy="${direction==1 and '0.57428 -0.23677 -1.8034' or '0.57428 0.23677 -1.3382'}"/>
      <parent link="${prefix}finger1_link1"/>
      <child link="${prefix}finger1_link2"/>
      <xacro:unless value="${fixed_joints}">
        <axis xyz="0 ${-direction} 0"/>
        <limit lower="-0.1387" upper="0.9324" effort="0.4259" velocity="11.1"/>
      </xacro:unless>
    </joint>
    <link name="${prefix}finger1_link3">
      <inertial>
        <origin xyz="-0.001123197 ${direction*1.572991e-05} 0.01305658" rpy="0 0 0"/>
        <mass value="0.0165"/>
        <inertia ixx="1.46e-06" ixy="0" ixz="-2e-08" iyy="1.42e-06" iyz="0" izz="4.5e-07"/>
