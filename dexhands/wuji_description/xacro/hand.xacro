<?xml version="1.0" encoding="utf-8"?>
<robot name="Wuji_$(arg type)" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:arg name="type" default="hand2"/>
	<xacro:arg name="direction" default="1"/>
	<xacro:arg name="use_mount" default="true"/>

	<xacro:include filename="$(find wuji_description)/xacro/hand2.xacro"/>
	<xacro:WujiHand2 name="" direction="$(arg direction)" use_mount="$(arg use_mount)"/>

</robot>
