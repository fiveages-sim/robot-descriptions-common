<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="InspireHandRH56E2" params="name:='' direction:=1 use_flange:=false ">

    <xacro:property name="prefix" value="${name + '_' if name else ''}"/>
    <xacro:property name="dir" value="${-1 * int(direction)}"/>

    <xacro:if value="${use_flange}">
      <link name="${prefix}flange">
        <inertial>
          <origin xyz="-0.000388 0.002345 0.0"/>
          <mass value="0.114"/>
          <inertia
              ixx="0.000040105"
              ixy="0.000000214"
              ixz="0.0"
              iyy="0.000085776"
              iyz="0.0"
              izz="0.000054044"/>
        </inertial>
        <visual>
          <geometry>
            <mesh filename="file://$(find inspire_description)/meshes/RH56E2/sensors/ft_sensor.glb"  scale="1 ${dir} 1" />
          </geometry>
        </visual>
      </link>
      <joint name="${prefix}flange_joint" type="fixed">
        <origin xyz="0 0 0.0355" rpy="0 0 ${-dir*1.5708}"/>
        <parent link="${prefix}flange"/>
        <child link="${prefix}hand_base"/>
      </joint>
    </xacro:if>

