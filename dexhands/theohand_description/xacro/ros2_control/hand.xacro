<?xml version="1.0"?>
<robot name="TheoHand_$(arg type)" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="type" default="std16a"/>
    <xacro:arg name="direction" default="1"/>
    <xacro:arg name="gazebo" default="false"/>
    <xacro:arg name="ros2_control_hardware_type" default="real"/>
    <xacro:arg name="serial_port" default="/dev/ttyUSB0"/>
    <xacro:arg name="slave_id" default="auto"/>
    <xacro:arg name="baudrate" default="115200"/>
    <xacro:arg name="read_feedback" default="true"/>

    <link name="world"/>

    <joint name="world_fixed" type="fixed">
        <parent link="world"/>
        <child link="hand_base"/>
        <origin/>
    </joint>

    <xacro:include filename="$(find theohand_description)/xacro/hand.xacro"/>
    <xacro:property name="theohand_slave_id" value="${2 if '$(arg slave_id)' == 'auto' and '$(arg direction)' != '-1' else 1 if '$(arg slave_id)' == 'auto' else '$(arg slave_id)'}"/>

    <ros2_control name="theohand_system" type="system">
        <hardware>
            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </xacro:if>
            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
                <plugin>mock_components/GenericSystem</plugin>
            </xacro:if>
            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
                <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
                <param name="joint_commands_topic">/isaac/joint_command</param>
                <param name="joint_states_topic">/isaac/joint_states</param>
                <param name="sum_wrapped_joint_states">false</param>
                <param name="initialize_commands_from_state">true</param>
            </xacro:if>
            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
                <plugin>modbus_ros2_control/TheoHandModbusHardware</plugin>
                <param name="serial_port">$(arg serial_port)</param>
                <param name="slave_id">${theohand_slave_id}</param>
                <param name="baudrate">$(arg baudrate)</param>
                <param name="read_feedback">$(arg read_feedback)</param>
            </xacro:if>
        </hardware>

        <xacro:if value="${'$(arg type)' == 'std16a'}">
            <xacro:include filename="$(find theohand_description)/xacro/ros2_control/std16a.xacro"/>
            <xacro:theohand_std16a_interfaces name=""/>
        </xacro:if>
    </ros2_control>

    <xacro:if value="$(arg gazebo)">
        <gazebo>
            <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <parameters>$(find theohand_description)/config/ros2_control/ros2_controllers.yaml</parameters>
            </plugin>
        </gazebo>
    </xacro:if>
</robot>
