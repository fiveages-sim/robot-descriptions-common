<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:macro name="BrainCoHand" params="name direction:=1 fixed_joints:=false">
		<xacro:property name="prefix" value="${name + '_' if name else ''}"/>
		<xacro:property name="joint_type" value="${fixed_joints and 'fixed' or 'revolute'}"/>

		<!-- ========================================== -->
		<!-- 手掌基座 (Hand Base) -->
		<!-- ========================================== -->
		<link name="${prefix}hand_base">
			<inertial>
				<origin xyz="${direction * -0.00099373} 0.040537 -0.0022835"/>
				<mass value="0.427"/>
				<inertia ixx="3.4364E-05"
								 ixy="${direction * -1.2404E-06}"
								 ixz="${direction * 5.654E-07}"
								 iyy="3.9467E-05"
								 iyz="3.8955E-06"
								 izz="6.3984E-05"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/visual/base_link.glb" scale="${direction} 1 1"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/collision/base_link.obj" scale="${direction} 1 1"/>
				</geometry>
			</collision>
		</link>

		<!-- Base Offset Link -->
		<link name="${prefix}base_offset"/>
		<joint name="${prefix}base_offset_joint" type="fixed">
			<origin xyz="0 0.0298242 0"/>
			<parent link="${prefix}hand_base"/>
			<child link="${prefix}base_offset"/>
		</joint>

		<!-- ========================================== -->
		<!-- 拇指部分 (Thumb) -->
		<!-- ========================================== -->
		<link name="${prefix}thumb_prox">
			<inertial>
				<origin xyz="${direction * 0.0062041} -7.9383E-08 0.0015306"/>
				<mass value="0.005"/>
				<inertia ixx="4.0639E-08"
								 ixy="${direction * 5.8675E-13}"
								 ixz="${direction * 2.4299E-09}"
								 iyy="9.2485E-08"
								 iyz="7.1049E-13"
								 izz="8.5586E-08"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/visual/thumb_proximal.glb" scale="${direction} 1 1"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/collision/thumb_proximal.obj" scale="${direction} 1 1"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}thumb_joint2" type="${joint_type}">
			<origin xyz="${direction * -0.0245}  0.0242 0.021628"
							rpy="0 ${direction *-1.0699} 0"/>
			<parent link="${prefix}base_offset"/>
			<child link="${prefix}thumb_prox"/>
			<xacro:unless value="${fixed_joints}">
				<axis xyz="0 ${direction} 0"/>
				<limit lower="0" upper="1.5708" effort="0" velocity="0"/>
			</xacro:unless>
		</joint>

		<link name="${prefix}thumb_dist">
			<inertial>
				<origin xyz="${direction * 0.0083564} 0.037204 -3.5884E-07"/>
				<mass value="0.04"/>
				<inertia ixx="7.1498E-06"
								 ixy="${direction * 2.0157E-07}"
								 ixz="${direction * -6.0726E-11}"
								 iyy="9.1501E-07"
								 iyz="5.4502E-10"
								 izz="6.8747E-06"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/visual/thumb_distal.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/collision/thumb_distal.obj"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}thumb_joint1" type="${joint_type}">
			<origin xyz="0 0 0.013647" rpy="0.87266 ${direction *-0.49642} 0"/>
			<axis xyz="-1 0 0"/>
			<parent link="${prefix}thumb_prox"/>
			<child link="${prefix}thumb_dist"/>
			<xacro:unless value="${fixed_joints}">
				<limit lower="0" upper="0.87266" effort="0" velocity="0"/>
			</xacro:unless>
		</joint>

		<!-- ========================================== -->
		<!-- 食指部分 (Index Finger) -->
		<!-- ========================================== -->
		<link name="${prefix}index_prox">
			<inertial>
				<origin xyz="-5.571E-07 0.016609 0.00045746"/>
				<mass value="0.008"/>
				<inertia ixx="3.3526E-07"
								 ixy="2.9401E-11"
								 ixz="-2.4782E-12"
								 iyy="1.0133E-07"
								 iyz="2.0576E-08"
								 izz="3.7092E-07"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/visual/index_proximal.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/collision/index_proximal.obj"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}index_joint" type="${joint_type}">
			<origin xyz="${direction*-0.029003}  0.088231 -0.0039488"
							rpy="-0.09929 ${direction * 0.054667} ${direction * 0.031168}"/>
			<parent link="${prefix}base_offset"/>
			<child link="${prefix}index_prox"/>
			<xacro:unless value="${fixed_joints}">
				<axis xyz="1 0 0"/>
				<limit lower="0" upper="1.309" effort="0" velocity="0"/>
			</xacro:unless>
		</joint>

		<link name="${prefix}index_dist">
			<inertial>
				<origin xyz="5.9401E-06 0.025449 0.003278"/>
				<mass value="0.011"/>
				<inertia ixx="8.4801E-07"
								 ixy="-1.0878E-09"
								 ixz="-1.3683E-10"
								 iyy="1.4147E-07"
								 iyz="-1.0078E-07"
								 izz="8.5502E-07"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/visual/index_distal.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/collision/index_distal.obj"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}index_pip_joint" type="${joint_type}">
			<origin xyz="0 0.035 0" rpy="0.19353 0 0"/>
			<parent link="${prefix}index_prox"/>
			<child link="${prefix}index_dist"/>
			<xacro:unless value="${fixed_joints}">
				<axis xyz="1 0 0"/>
				<limit lower="0" upper="2.0944" effort="0" velocity="0"/>
				<mimic joint="${prefix}index_joint" multiplier="1.2" offset="0.19373154697137057"/>
			</xacro:unless>
		</joint>

		<!-- ========================================== -->
		<!-- 中指部分 (Middle Finger) -->
		<!-- ========================================== -->
		<link name="${prefix}middle_prox">
			<inertial>
				<origin xyz="2.3779E-07 0.020205 0.00053993"/>
				<mass value="0.011"/>
				<inertia ixx="5.5624E-07"
								 ixy="8E-12"
								 ixz="-8.5151E-12"
								 iyy="1.3298E-07"
								 iyz="2.669E-08"
								 izz="6.0146E-07"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/visual/ring_proximal.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/collision/ring_proximal.obj"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}middle_joint" type="${joint_type}">
			<origin xyz="${direction * -0.008} 0.091935 -0.0082038"
							rpy="-0.069813 0 0"/>
			<parent link="${prefix}base_offset"/>
			<child link="${prefix}middle_prox"/>
			<xacro:unless value="${fixed_joints}">
				<axis xyz="1 0 0"/>
				<limit lower="0" upper="1.309" effort="0" velocity="0"/>
			</xacro:unless>
		</joint>

		<link name="${prefix}middle_dist">
			<inertial>
				<origin xyz="5.9404E-06 0.025449 0.003278"/>
				<mass value="0.011"/>
				<inertia ixx="8.4801E-07"
								 ixy="-1.0879E-09"
								 ixz="-1.3705E-10"
								 iyy="1.4147E-07"
								 iyz="-1.0078E-07"
								 izz="8.5501E-07"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/visual/middle_distal.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/collision/middle_distal.obj"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}middle_pip_joint" type="${joint_type}">
			<origin xyz="0 0.042 0" rpy="0.18357 0 0"/>
			<parent link="${prefix}middle_prox"/>
			<child link="${prefix}middle_dist"/>
			<xacro:unless value="${fixed_joints}">
				<axis xyz="1 0 0"/>
				<limit lower="0" upper="2.0944" effort="0" velocity="0"/>
				<mimic joint="${prefix}middle_joint" multiplier="1.2" offset="0.1832595714594046"/>
			</xacro:unless>
		</joint>

		<!-- ========================================== -->
		<!-- 无名指部分 (Ring Finger) -->
		<!-- ========================================== -->
		<link name="${prefix}ring_prox">
			<inertial>
				<origin xyz="2.4507E-07 0.020236 0.00042373"/>
				<mass value="0.011"/>
				<inertia ixx="5.5623E-07"
								 ixy="7.4604E-12"
								 ixz="-8.5876E-12"
								 iyy="1.3295E-07"
								 iyz="2.7719E-08"
								 izz="6.0149E-07"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/visual/ring_proximal.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/collision/ring_proximal.obj"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}ring_joint" type="${joint_type}">
			<origin xyz="${direction * 0.013103}  0.089947  -0.0080786"
							rpy="-0.079113 ${direction * -0.054667} ${direction * -0.031168}"/>
			<parent link="${prefix}base_offset"/>
			<child link="${prefix}ring_prox"/>
			<xacro:unless value="${fixed_joints}">
				<axis xyz="1 0 0"/>
				<limit lower="0" upper="1.309" effort="0" velocity="0"/>
			</xacro:unless>
		</joint>

		<link name="${prefix}ring_dist">
			<inertial>
				<origin xyz="5.5799E-07 0.020388 0.0029077"/>
				<mass value="0.008"/>
				<inertia ixx="3.6793E-07"
								 ixy="-6.504E-13"
								 ixz="-1.1541E-11"
								 iyy="8.4208E-08"
								 iyz="-4.5737E-08"
								 izz="3.8369E-07"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/visual/ring_distal.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/collision/ring_distal.obj"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}ring_pip_joint" type="${joint_type}">
			<origin xyz="0 0.042 0" rpy="0.16583 0 0"/>
			<parent link="${prefix}ring_prox"/>
			<child link="${prefix}ring_dist"/>
			<xacro:unless value="${fixed_joints}">
				<axis xyz="1 0 0"/>
				<limit lower="0" upper="2.0944" effort="0" velocity="0"/>
				<mimic joint="${prefix}ring_joint" multiplier="1.2" offset="0.16580627893946132"/>
			</xacro:unless>
		</joint>

		<!-- ========================================== -->
		<!-- 小指部分 (Pinky Finger) -->
		<!-- ========================================== -->
		<link name="${prefix}pinky_prox">
			<inertial>
				<origin xyz="-5.4618E-07 0.016662 0.00040738"/>
				<mass value="0.008"/>
				<inertia ixx="3.3526E-07"
								 ixy="2.8461E-11"
								 ixz="-2.3358E-12"
								 iyy="1.0129E-07"
								 iyz="2.1346E-08"
								 izz="3.7096E-07"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/visual/pinky_proximal.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/collision/pinky_proximal.obj"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}pinky_joint" type="${joint_type}">
			<origin xyz="${direction * 0.033731} 0.083727  -0.0036339"
							rpy="-0.094666 ${direction * -0.057099} ${direction * -0.065996}"/>
			<parent link="${prefix}base_offset"/>
			<child link="${prefix}pinky_prox"/>
			<xacro:unless value="${fixed_joints}">
				<axis xyz="1 0 0"/>
				<limit lower="0" upper="1.309" effort="0" velocity="0"/>
			</xacro:unless>
		</joint>

		<link name="${prefix}pinky_dist">
			<inertial>
				<origin xyz="1.062E-05 0.017869 0.0020864"/>
				<mass value="0.008"/>
				<inertia ixx="2.3262E-07"
								 ixy="-4.9135E-10"
								 ixz="-4.9506E-11"
								 iyy="6.4304E-08"
								 iyz="-2.3564E-08"
								 izz="2.4916E-07"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/visual/pinky_distal.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find brainco_description)/meshes/revo1/collision/pinky_distal.obj"/>
				</geometry>
			</collision>
		</link>

		<joint name="${prefix}pinky_pip_joint" type="${joint_type}">
			<origin xyz="0 0.035 0" rpy="0.20294 0 0"/>
			<parent link="${prefix}pinky_prox"/>
			<child link="${prefix}pinky_dist"/>
			<xacro:unless value="${fixed_joints}">
				<axis xyz="1 0 0"/>
				<limit lower="0" upper="2.0944" effort="0" velocity="0"/>
				<mimic joint="${prefix}pinky_joint" multiplier="1.2" offset="0.20245819323134223"/>
			</xacro:unless>
		</joint>

	</xacro:macro>

</robot>
