<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!--DH-Robotics DH-3-7. Preserve the independent vendor left/right trees and SI units.-->
    <xacro:macro name="DH3_7" params="name direction:=1 fixed_joints:=false">
        <xacro:property name="prefix" value="${name + '_' if name else ''}" />
        <xacro:property name="is_fixed" value="${str(fixed_joints).lower() in ('true', '1')}" />
        <xacro:property name="joint_type" value="${'fixed' if is_fixed else 'revolute'}" />
        <xacro:property name="side" value="${dict([(1, 'left'), (-1, 'right')])[int(direction)]}" />
        <xacro:if value="${side == 'left'}">
            <!--Source: UDH3_7L_0903/urdf/UDH3_7L_0903.urdf. Keep all original origins, axes, inertias and limits.-->
            <link name="${prefix}hand_base">
                <inertial>
                    <origin xyz="-0.0092196 -0.0084715 0.042003" rpy="0 0 0" />
                    <mass value="0.52839" />
                    <inertia ixx="0.0002466" ixy="-3.4559E-06" ixz="1.2499E-05" iyy="0.00026968" iyz="3.9916E-06" izz="0.00035655" />
                </inertial>
                <visual>
                    <origin xyz="0 0 0" rpy="0 0 0" />
                    <geometry>
                        <mesh filename="file://$(find dh_description)/meshes/dh_3_7/left/base_link.STL" />
                    </geometry>
                    <material name="${prefix}dh_3_7_material">
                        <color rgba="0.75294 0.75294 0.75294 1" />
                    </material>
                </visual>
                <collision>
                    <origin xyz="0 0 0" rpy="0 0 0" />
                    <geometry>
                        <mesh filename="file://$(find dh_description)/meshes/dh_3_7/left/base_link.STL" />
                    </geometry>
                </collision>
            </link>
            <link name="${prefix}hand_thumb_link1">
                <inertial>
                    <origin xyz="-0.011931 0.025154 0.0074692" rpy="0 0 0" />
                    <mass value="0.16058" />
                    <inertia ixx="4.5598E-05" ixy="3.2067E-06" ixz="1.1997E-06" iyy="3.8627E-05" iyz="6.4796E-07" izz="2.647E-05" />
                </inertial>
                <visual>
                    <origin xyz="0 0 0" rpy="0 0 0" />
                    <geometry>
                        <mesh filename="file://$(find dh_description)/meshes/dh_3_7/left/LF1R_Link.STL" />
                    </geometry>
                    <material name="${prefix}dh_3_7_material">
                        <color rgba="0.75294 0.75294 0.75294 1" />
                    </material>
                </visual>
                <collision>
                    <origin xyz="0 0 0" rpy="0 0 0" />
                    <geometry>
                        <mesh filename="file://$(find dh_description)/meshes/dh_3_7/left/LF1R_Link.STL" />
                    </geometry>
                </collision>
            </link>
            <joint name="${prefix}thumb_joint1" type="${joint_type}">
                <origin xyz="0.0145 0.0075 0.04815" rpy="0 0 0" />
                <parent link="${prefix}hand_base" />
                <child link="${prefix}hand_thumb_link1" />
                <xacro:unless value="${is_fixed}">
                    <axis xyz="0 0 1" />
                    <limit lower="-3.14" upper="0" effort="10" velocity="5" />
                    <dynamics damping="0.1" friction="10" />
                </xacro:unless>
            </joint>
            <link name="${prefix}hand_thumb_link2">
                <inertial>
                    <origin xyz="-0.00073029 0.033024 -6.3248E-05" rpy="0 0 0" />
