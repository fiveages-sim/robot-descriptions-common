<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find inspire_description)/xacro/ros2_control/RH56E2.xacro"/>
  <xacro:include filename="$(find inspire_description)/xacro/ros2_control/RH56F2.xacro"/>

  <xacro:macro name="side_ros2_control_system" params="name rw_rate:='' *contents">
    <xacro:if value="${rw_rate != ''}">
      <ros2_control name="${name}" type="system" rw_rate="${rw_rate}">
        <xacro:insert_block name="contents"/>
      </ros2_control>
    </xacro:if>
    <xacro:unless value="${rw_rate != ''}">
      <ros2_control name="${name}" type="system">
        <xacro:insert_block name="contents"/>
      </ros2_control>
    </xacro:unless>
  </xacro:macro>

  <xacro:macro name="inspire_rs485_side_system" params="side serial_port baudrate:=115200 slave_id:=auto read_feedback:=true hand_type:=inspire_e2 rw_rate:=''">
    <xacro:side_ros2_control_system name="${hand_type}_${side}_system" rw_rate="${rw_rate}">
      <contents>
        <hardware>
          <plugin>modbus_ros2_control/InspireHandHardware</plugin>
          <param name="serial_port">${serial_port}</param>
          <param name="hand_side">${side}</param>
          <param name="baudrate">${baudrate}</param>
          <param name="slave_id">${slave_id}</param>
          <param name="read_feedback">${read_feedback}</param>
        </hardware>
        <xacro:if value="${hand_type == 'inspire_e2'}">
          <xacro:inspire_rh56e2_interfaces name="${side}_hand"/>
        </xacro:if>
        <xacro:if value="${hand_type == 'inspire_f2'}">
          <xacro:inspire_rh56f2_interfaces name="${side}_hand"/>
        </xacro:if>
      </contents>
    </xacro:side_ros2_control_system>
  </xacro:macro>

  <xacro:macro name="inspire_canfd_side_system" params="side can_interface hand_id:=auto read_feedback:=true hand_type:=inspire_e2 rw_rate:=''">
    <xacro:side_ros2_control_system name="${hand_type}_${side}_canfd_system" rw_rate="${rw_rate}">
      <contents>
        <hardware>
          <plugin>can_ros2_control/InspireCanfdHardware</plugin>
          <param name="can_interface">${can_interface}</param>
          <param name="hand_side">${side}</param>
          <param name="hand_id">${hand_id}</param>
          <param name="read_feedback">${read_feedback}</param>
          <param name="feedback_timeout_ms">2</param>
        </hardware>
        <xacro:if value="${hand_type == 'inspire_e2'}">
          <xacro:inspire_rh56e2_interfaces name="${side}_hand"/>
        </xacro:if>
        <xacro:if value="${hand_type == 'inspire_f2'}">
          <xacro:inspire_rh56f2_interfaces name="${side}_hand"/>
        </xacro:if>
      </contents>
    </xacro:side_ros2_control_system>
  </xacro:macro>

</robot>
