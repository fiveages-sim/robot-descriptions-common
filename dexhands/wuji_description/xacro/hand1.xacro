      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find wuji_description)/meshes/hand1/${mesh_side}/${mesh_side}_finger1_link3.STL"/>
        </geometry>
        <material name="">
          <color rgba="0.627451 0.627451 0.627451 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find wuji_description)/meshes/hand1/${mesh_side}/${mesh_side}_finger1_link3.STL"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}finger1_joint3" type="${joint_type}">
      <origin xyz="${direction*0.00026671} 0.0009915 0.034666" rpy="${direction==1 and '-0.049049 0.017311 1.9085' or '0.04904945 0.01731124 1.233052'}"/>
      <parent link="${prefix}finger1_link2"/>
      <child link="${prefix}finger1_link3"/>
      <xacro:unless value="${fixed_joints}">
        <axis xyz="0 1 0"/>
        <limit lower="-0.4642" upper="1.5623" effort="0.1888" velocity="12.863"/>
      </xacro:unless>
    </joint>
    <link name="${prefix}finger1_link4">
      <inertial>
        <origin xyz="-0.0011922 ${direction*0.00021414} 0.0082113" rpy="0 0 0"/>
        <mass value="0.0165"/>
        <inertia ixx="1.18e-06" ixy="0" ixz="1.2e-07" iyy="1.25e-06" iyz="0" izz="5.1e-07"/>
      </inertial>
      <visual>
